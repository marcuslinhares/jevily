node_modules/
dist/
data/
*.log
.env
.env.local
coverage/

# Credentials. A key file dropped in the project root is the easy mistake to make;
# .gitignore is the backstop, not the plan. Prefer a .env (already ignored above).
*.key
*.key.txt
*key*.txt
*secret*
*token*

# Crawled corpus. Every measurement in the README is taken against this, so it is
# deliberately not in /tmp: a cleaned tmpdir silently invalidates a day of probing
# and the next run reports numbers for an empty index.
.corpus/
