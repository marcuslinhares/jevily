# --- server -----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
DATA_DIR=./data
# Comma-separated keys. Leave empty to run open (local development only).
# API_KEYS=jev_live_xxx,jev_live_yyy

# --- decision engine --------------------------------------------------------
# The pipeline's judgements run on Jev, a System One model: typed questions in,
# typed answers with calibrated probabilities out.
#
#   auto      -> systemone if DECISION_API_KEY is set, else mock
#   systemone -> POST {DECISION_BASE_URL}/v1/systemone   (calibrated, recommended)
#   openrouter-> a chat model with a strict JSON schema   (NOT calibrated, fallback)
#   mock      -> deterministic offline stand-in
DECISION_ENGINE=auto

# Two providers speak the System One protocol, and the config derives the model id
# to match whichever host you point at. Set the key, or the base URL, and the rest
# follows.

# TypeSafe direct:
# DECISION_API_KEY=ts_...
# DECISION_BASE_URL=https://api.typesafe.ai
# DECISION_MODEL=jev-latest

# OpenRouter (same model, same protocol, billed to your OpenRouter account).
# This is the default whenever OPENROUTER_API_KEY is set and no override is given.
# DECISION_API_KEY=sk-or-...
# DECISION_BASE_URL=https://openrouter.ai/api
# DECISION_MODEL=typesafe/jev-latest

DECISION_CONCURRENCY=8
DECISION_TIMEOUT_MS=30000
DECISION_MAX_RETRIES=3
DECISION_CACHE=true
DECISION_CACHE_TTL_S=86400

# Only used by the uncalibrated `openrouter` engine above.
DECISION_CHAT_MODEL=openai/gpt-4.1-mini

# OpenRouter also serves generation and embeddings with the same key.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- answer generation ------------------------------------------------------
# Jev cannot write prose. Answer synthesis needs a generative model.
GENERATOR_PROVIDER=none
GENERATOR_MODEL=openai/gpt-4.1-mini
GENERATOR_MAX_TOKENS=1200
GENERATOR_TIMEOUT_MS=60000

# --- dense retrieval (optional) --------------------------------------------
# Without this the lexical channel carries the whole load.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMS=512
HYBRID_ENABLED=true
FUSION_RRF_K=60

# --- crawler ----------------------------------------------------------------
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=1000
CRAWL_TIMEOUT_MS=20000
CRAWL_MAX_BYTES=3000000
CRAWL_RESPECT_ROBOTS=true
CRAWL_MAX_PAGES_PER_HOST=500
CRAWL_USER_AGENT=jevily-bot/0.1 (+https://github.com/jevily)

# --- pipeline defaults ------------------------------------------------------
DEFAULT_MAX_RESULTS=10
DEFAULT_CANDIDATE_POOL=60
DEFAULT_CANDIDATES_RERANKED=24
# Withhold the answer and return the evidence when it is too weak to support one.
ABSTAIN_ENABLED=true
VERIFY_CITATIONS=true
